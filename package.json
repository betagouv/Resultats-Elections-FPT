{
  "name": "resultats-elections-fpt",
  "version": "1.0.0",
  "description": "Saisir et centraliser les résultats des élections professionnelles dans la fonction publique territoriale",
  "type": "module",
  "scripts": {
    "dev:html": "http-server --port 5173 ./apps-html",
    "copy:html": "cp -r apps-html/* dist/",
    "dev:fiche": "vite --mode vue-fiche",
    "preview:fiche": "vite preview --mode vue-fiche",
    "build:fiche": "vite build --mode vue-fiche",
    "dev:tableau": "vite --mode vue-tableau",
    "preview:tableau": "vite preview --mode vue-tableau",
    "build:tableau": "vite build --mode vue-tableau",
    "dev:formulaire": "vite --mode vue-formulaire",
    "preview:formulaire": "vite preview --mode vue-formulaire",
    "build:formulaire": "vite build --mode vue-formulaire",
    "dev:bouton": "vite --mode vue-bouton",
    "preview:bouton": "vite preview --mode vue-bouton",
    "build:bouton": "vite build --mode vue-bouton",
    "dev:recherche": "vite --mode vue-recherche",
    "preview:recherche": "vite preview --mode vue-recherche",
    "build:recherche": "vite build --mode vue-recherche",
    "dev:iframe": "vite --mode vue-iframe",
    "preview:iframe": "vite preview --mode vue-iframe",
    "build:iframe": "vite build --mode vue-iframe",
    "dev:rattachement": "vite --mode vue-rattachement",
    "preview:rattachement": "vite preview --mode vue-rattachement",
    "build:rattachement": "vite build --mode vue-rattachement",
    "build": "npm run build:fiche && npm run build:tableau && npm run build:formulaire && npm run build:bouton && npm run build:recherche && npm run build:iframe && npm run build:rattachement && npm run copy:html",
    "build:staging": "npm run build && npm run copy:staging",
    "copy:staging": "cp -r dist/* staging/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betagouv/Resultats-Elections-FPT.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/betagouv/Resultats-Elections-FPT/issues"
  },
  "homepage": "https://github.com/betagouv/Resultats-Elections-FPT#readme",
  "dependencies": {
    "@gouvfr/dsfr": "^1.14.3",
    "@gouvminint/vue-dsfr": "^8.17.2",
    "@vueuse/core": "^14.1.0",
    "jsonrepair": "^3.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.4.21",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "dotenv": "^17.4.2",
    "http-server": "^14.1.1",
    "vite": "^5.2.0"
  }
}
